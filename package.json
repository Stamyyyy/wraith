{
  "name": "wraith",
  "version": "2.0.0",
  "description": "A transparent, see-through Notepad replacement with real formatting, plus built-in WSL and Command Prompt terminals.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps || exit 0",
    "dist": "electron-builder"
  },
  "author": "Stam",
  "license": "UNLICENSED",
  "dependencies": {
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.stam.wraith",
    "productName": "Wraith",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico",
      "node_modules/@xterm/**/*"
    ]
  }
}
